        </mxCell>
        <mxCell id="8x0X_XjyQY9exBeBYlOf-118" value="&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Персональные данные собственников&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
